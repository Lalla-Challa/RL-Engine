{
  "environment": {
    "id": "legal-filing-office",
    "version": "1.1.0",
    "specVersion": "1.0",
    "description": "Legal Discovery and Motion Filing — synthetic workflow pack. Evidence is gathered, discovery is closed, then a motion may be filed within the deadline window. Exercises enum state progression, $field deadline enforcement, and sequential workflow gates. No real legal or client data. v1.1.0 (red-team remediation R3): evidence accrual requires an open discovery, and file_motion enforces the filing-day window (5-30) directly in its rule conditions — the deadline is now substantive, not just a field clamp."
  },
  "state": {
    "discovery_status": {
      "type": "enum",
      "allowedValues": [
        "none",
        "open",
        "closed"
      ],
      "default": "none"
    },
    "evidence_count": {
      "type": "integer",
      "min": 0,
      "max": 50,
      "default": 0
    },
    "motions_filed": {
      "type": "integer",
      "min": 0,
      "max": 20,
      "default": 0
    },
    "filing_day": {
      "type": "integer",
      "min": 5,
      "max": 30,
      "default": 5
    },
    "day": {
      "type": "integer",
      "min": 0,
      "max": 200,
      "default": 0
    },
    "filing_violation": {
      "type": "integer",
      "min": 0,
      "max": 1,
      "default": 0,
      "description": "violation flag: any file_motion attempt outside day 5-30 trips the filing_window constraint and rejects the transition"
    }
  },
  "entities": [
    {
      "id": "case_1",
      "type": "case",
      "attributes": {
        "jurisdiction": "civil"
      },
      "state": {
        "phase": "pre-discovery"
      }
    },
    {
      "id": "attorney_1",
      "type": "person",
      "attributes": {
        "role": "attorney"
      },
      "state": {
        "load": 0
      }
    },
    {
      "id": "court_main",
      "type": "institution",
      "attributes": {
        "tier": "district"
      },
      "state": {
        "docket": 0
      }
    }
  ],
  "relationships": [
    {
      "id": "attorney-case",
      "source": "attorney_1",
      "target": "case_1",
      "type": "represents",
      "state": {
        "standing": "active"
      }
    },
    {
      "id": "case-court",
      "source": "case_1",
      "target": "court_main",
      "type": "filed_in",
      "state": {
        "standing": "pending"
      }
    }
  ],
  "actions": [
    {
      "kind": "discrete",
      "actions": [
        "open_discovery",
        "gather_evidence",
        "close_discovery",
        "file_motion",
        "extend_deadline",
        "audit_case"
      ]
    }
  ],
  "rules": [
    {
      "id": "open_discovery_rule",
      "conditions": [
        {
          "field": "action",
          "op": "eq",
          "value": "open_discovery"
        },
        {
          "field": "discovery_status",
          "op": "eq",
          "value": "none"
        }
      ],
      "effects": [
        {
          "target": "state",
          "field": "discovery_status",
          "op": "set",
          "value": "open"
        }
      ],
      "priority": 10,
      "probability": 1,
      "enabled": true,
      "cooldown": 0,
      "scope": "global"
    },
    {
      "id": "gather_evidence_rule",
      "conditions": [
        {
          "field": "action",
          "op": "eq",
          "value": "gather_evidence"
        },
        {
          "field": "discovery_status",
          "op": "eq",
          "value": "open"
        }
      ],
      "effects": [
        {
          "target": "state",
          "field": "evidence_count",
          "op": "add",
          "value": 5
        }
      ],
      "priority": 9,
      "probability": 1,
      "enabled": true,
      "cooldown": 0,
      "scope": "global"
    },
    {
      "id": "close_discovery_rule",
      "conditions": [
        {
          "field": "action",
          "op": "eq",
          "value": "close_discovery"
        },
        {
          "field": "discovery_status",
          "op": "eq",
          "value": "open"
        },
        {
          "field": "evidence_count",
          "op": "gte",
          "value": 10
        }
      ],
      "effects": [
        {
          "target": "state",
          "field": "discovery_status",
          "op": "set",
          "value": "closed"
        }
      ],
      "priority": 9,
      "probability": 1,
      "enabled": true,
      "cooldown": 0,
      "scope": "global"
    },
    {
      "id": "file_motion_rule",
      "conditions": [
        {
          "field": "action",
          "op": "eq",
          "value": "file_motion"
        },
        {
          "field": "discovery_status",
          "op": "eq",
          "value": "closed"
        },
        {
          "field": "day",
          "op": "gte",
          "value": 5
        },
        {
          "field": "day",
          "op": "lte",
          "value": 30
        }
      ],
      "effects": [
        {
          "target": "state",
          "field": "motions_filed",
          "op": "increment",
          "value": 1
        },
        {
          "target": "state",
          "field": "filing_day",
          "op": "set",
          "value": {
            "$field": "day"
          }
        }
      ],
      "priority": 10,
      "probability": 1,
      "enabled": true,
      "cooldown": 0,
      "scope": "global"
    },
    {
      "id": "extend_deadline_rule",
      "conditions": [
        {
          "field": "action",
          "op": "eq",
          "value": "extend_deadline"
        },
        {
          "field": "discovery_status",
          "op": "eq",
          "value": "open"
        }
      ],
      "effects": [
        {
          "target": "state",
          "field": "evidence_count",
          "op": "add",
          "value": 1
        }
      ],
      "priority": 3,
      "probability": 1,
      "enabled": true,
      "cooldown": 0,
      "scope": "global"
    },
    {
      "id": "audit_case_rule",
      "conditions": [
        {
          "field": "action",
          "op": "eq",
          "value": "audit_case"
        },
        {
          "field": "discovery_status",
          "op": "eq",
          "value": "open"
        }
      ],
      "effects": [
        {
          "target": "state",
          "field": "evidence_count",
          "op": "add",
          "value": 1
        }
      ],
      "priority": 3,
      "probability": 1,
      "enabled": true,
      "cooldown": 0,
      "scope": "global"
    },
    {
      "id": "heartbeat",
      "conditions": [
        {
          "field": "action",
          "op": "exists"
        }
      ],
      "effects": [
        {
          "target": "state",
          "field": "day",
          "op": "increment",
          "value": 1
        }
      ],
      "priority": 1,
      "probability": 1,
      "enabled": true,
      "cooldown": 0,
      "scope": "global"
    },
    {
      "id": "filing_window_block",
      "conditions": [
        {
          "field": "action",
          "op": "eq",
          "value": "file_motion"
        },
        {
          "any": [
            {
              "field": "day",
              "op": "lt",
              "value": 5
            },
            {
              "field": "day",
              "op": "gt",
              "value": 30
            }
          ]
        }
      ],
      "effects": [
        {
          "target": "state",
          "field": "filing_violation",
          "op": "set",
          "value": 1
        }
      ],
      "priority": 12,
      "probability": 1,
      "enabled": true,
      "cooldown": 0,
      "scope": "global"
    }
  ],
  "observations": {
    "fields": [
      {
        "field": "discovery_status",
        "source": "discovery_status",
        "visibility": "public"
      },
      {
        "field": "evidence_count",
        "source": "evidence_count",
        "visibility": "public"
      },
      {
        "field": "motions_filed",
        "source": "motions_filed",
        "visibility": "public"
      },
      {
        "field": "day",
        "source": "day",
        "visibility": "public"
      }
    ],
    "fullyObservable": false
  },
  "rewards": {
    "components": [
      {
        "id": "evidence_progress",
        "expression": "state.evidence_count - prevState.evidence_count",
        "weight": 0.4
      },
      {
        "id": "motion_reward",
        "expression": "state.motions_filed - prevState.motions_filed",
        "weight": 5
      },
      {
        "id": "day_cost",
        "expression": "state.day - prevState.day",
        "weight": -0.05
      }
    ]
  },
  "constraints": [
    {
      "id": "deadline_range",
      "type": "range",
      "target": {
        "field": "filing_day",
        "min": 5,
        "max": 30
      },
      "priority": 1,
      "satisfied": false
    },
    {
      "id": "premature_filing",
      "type": "range",
      "target": {
        "field": "evidence_count",
        "min": 0,
        "max": 50
      },
      "priority": 1,
      "satisfied": false
    },
    {
      "id": "filing_window",
      "type": "range",
      "target": {
        "field": "filing_violation",
        "min": 0,
        "max": 0
      },
      "priority": 1,
      "satisfied": false
    }
  ],
  "termination": [
    {
      "field": "motions_filed",
      "op": "gte",
      "value": 3,
      "kind": "terminated"
    },
    {
      "field": "",
      "op": "eq",
      "value": 0,
      "kind": "truncated",
      "maxSteps": 120
    }
  ]
}