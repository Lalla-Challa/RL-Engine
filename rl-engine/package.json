{
  "name": "rl-engine",
  "version": "0.1.0",
  "type": "module",
  "description": "Generic Reinforcement Learning Environment Engine — domain-independent reset()/step() environments compiled from declarative specifications (Software Architecture Specification v1.0, §1-47). Deterministic, atomic, persistence-outside-kernel, offline.",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./persistence": {
      "types": "./dist/persistence/index.d.ts",
      "import": "./dist/persistence/index.js",
      "require": "./dist/persistence/index.cjs"
    },
    "./packs/*": "./dist/domain-packs/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "domain-packs/",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../vendor/node_modules/tsx/dist/cli.mjs ../../rl-engine/build-dist.mts",
    "smoke": "node --import tsx testing/smoke.ts",
    "determinism": "node --import tsx testing/determinism-gate.ts",
    "check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "better-sqlite3-multiple-ciphers": "^13.0.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.6.0"
  }
}
