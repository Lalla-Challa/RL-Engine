{"environment":{"id":"meridian-exchange","version":"1.0.0","specVersion":"1.0","description":"Meridian Exchange — synthetic single-asset trading pack. Exercises continuous action spaces (fractional order sizing), float state schema, multiply/divide math on fills and fees, declarative $field/$mul effect resolution, and multi-component reward shaping (PnL minus quadratic inventory risk). No real market data or ticker symbols."},"state":{"cash":{"type":"float","min":0,"max":1000000,"default":10000},"shares":{"type":"float","min":-500,"max":500,"default":0},"price":{"type":"float","min":1,"max":10000,"default":100},"order_shares":{"type":"float","min":-1000,"max":1000,"default":0},"fills":{"type":"integer","min":0,"max":100000,"default":0},"halted":{"type":"boolean","default":false}},"entities":[{"id":"trader","type":"account","attributes":{"segment":"retail"},"state":{"margin":false}},{"id":"exchange","type":"venue","attributes":{"tick_size":0.01},"state":{"session":"open"}}],"relationships":[{"id":"trader-exchange","source":"trader","target":"exchange","type":"accounts_at","state":{"tier":"standard"}}],"actions":[{"kind":"discrete","actions":["hold","mark_session"]},{"kind":"continuous","type":"trade","field":"order_shares","min":-50,"max":50}],"rules":[{"id":"fill","conditions":[{"any":[{"field":"order_shares","op":"gt","value":0.01},{"field":"order_shares","op":"lt","value":-0.01}]}],"effects":[{"target":"state","field":"shares","op":"add","value":{"$field":"order_shares"}},{"target":"state","field":"cash","op":"subtract","value":{"$mul":[{"$field":"order_shares"},{"$field":"price"}]}},{"target":"state","field":"fills","op":"increment","value":1}],"priority":10,"probability":1,"enabled":true,"cooldown":0,"scope":"global"},{"id":"fee","conditions":[{"any":[{"field":"order_shares","op":"gt","value":0.01},{"field":"order_shares","op":"lt","value":-0.01}]}],"effects":[{"target":"state","field":"cash","op":"multiply","value":0.999}],"priority":9,"probability":1,"enabled"