{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "rl-engine/**/*.ts",
    "benchmark/**/*.ts",
    "docs/examples/**/*.ts"
  ],
  "exclude": [
    "engine-core",
    "rl-engine/dist",
    "vendor"
  ]
}
