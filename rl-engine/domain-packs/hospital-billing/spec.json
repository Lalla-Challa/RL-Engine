{
  "environment": {
    "id": "hospital-billing-bridge",
    "version": "1.1.0",
    "specVersion": "1.0",
    "description": "Hospital Billing Bridge — synthetic cross-application pack (EHR ↔ Pharmacy ↔ Billing). A patient is admitted via the EHR, medication is dispensed via the Pharmacy module, and an invoice is generated and paid via Billing — but payment is only legal after dispensing. Exercises multi-system state progression, cross-boundary compliance gates, and distributed workflow rewards. No real clinical or financial data. v1.1.0 (red-team remediation R1): generate_invoice requires invoice_status==none (set-once; paid invoices cannot be re-armed), both billing rules carry a cooldown, and a cross-field constraint bounds payments by invoices (payment_requires_dispense). One dispense = one billable unit: collect consumes the dispense (med_status=consumed), invoices can only be re-opened after payment, and payment_debt (payments - invoices) is constraint-clamped to 0."
  },
  "state": {
    "patient_status": {
      "type": "enum",
      "allowedValues": [
        "none",
        "admitted",
        "discharged"
      ],
      "default": "none"
    },
    "med_status": {
      "type": "enum",
      "allowedValues": [
        "none",
        "prescribed",
        "dispensed",
        "consumed"
      ],
      "default": "none"
    },
    "invoice_status": {
      "type": "enum",
      "allowedValues": [
        "none",
        "generated",
        "paid"
      ],
      "default": "none"
    },
    "invoices_generated": {
      "type": "integer",
      "min": 0,
      "max": 50,
      "default": 0
    },
    "payments_collected": {
      "type": "integer",
      "min": 0,
      "max": 50,
      "default": 0
    },
    "account_balance": {
      "type": "float",
      "min": 0,
      "max": 100000,
      "default": 0
    },
    "day": {
      "type": "integer",
      "min": 0,
      "max": 200,
      "default": 0
    },
    "payment_debt": {
      "type": "integer",
      "min": 0,
      "max": 50,
      "default": 0,
      "description": "payments_collected - invoices_generated; positive value would be double-billing"
    }
  },
  "entities": [
    {
      "id": "patient_1",
      "type": "person",
      "attributes": {
        "role": "patient"
      },
      "state": {
        "ward": "none"
      }
    },
    {
      "id": "ehr_system",
      "type": "system",
      "attributes": {
        "module": "ehr"
      },
      "state": {
        "records": 0
      }
    },
    {
      "id": "pharmacy_system",
      "type": "system",
      "attributes": {
        "module": "pharmacy"
      },
      "state": {
        "dispenses": 0
      }
    },
    {
      "id": "billing_system",
      "type": "system",
      "attributes": {
        "module": "billing"
      },
      "state": {
        "invoices": 0
      }
    }
  ],
  "relationships": [
    {
      "id": "patient-ehr",
      "source": "patient_1",
      "target": "ehr_system",
      "type": "registered_in",
      "state": {
        "standing": "none"
      }
    },
    {
      "id": "ehr-pharmacy",
      "source": "ehr_system",
      "target": "pharmacy_system",
      "type": "feeds",
      "state": {
        "standing": "active"
      }
    },
    {
      "id": "ehr-billing",
      "source": "ehr_system",
      "target": "billing_system",
      "type": "feeds",
      "state": {
        "standing": "active"
      }
    }
  ],
  "actions": [
    {
      "kind": "discrete",
      "actions": [
        "admit_patient",
        "prescribe_meds",
        "dispense_meds",
        "generate_invoice",
        "collect_payment",
        "audit_billing"
      ]
    }
  ],
  "rules": [
    {
      "id": "admit_patient_rule",
      "conditions": [
        {
          "field": "action",
          "op": "eq",
          "value": "admit_patient"
        },
        {
          "field": "patient_status",
          "op": "eq",
          "value": "none"
        }
      ],
      "effects": [
        {
          "target": "state",
          "field": "patient_status",
          "op": "set",
          "value": "admitted"
        }
      ],
      "priority": 10,
      "probability": 1,
      "enabled": true,
      "cooldown": 0,
      "scope": "global"
    },
    {
      "id": "prescribe_meds_rule",
      "conditions": [
        {
          "field": "action",
          "op": "eq",
          "value": "prescribe_meds"
        },
        {
          "field": "patient_status",
          "op": "eq",
          "value": "admitted"
        },
        {
          "field": "med_status",
          "op": "in",
          "value": [
            "none",
            "consumed"
          ]
        }
      ],
      "effects": [
        {
          "target": "state",
          "field": "med_status",
          "op": "set",
          "value": "prescribed"
        }
      ],
      "priority": 9,
      "probability": 1,
      "enabled": true,
      "cooldown": 0,
      "scope": "global"
    },
    {
      "id": "dispense_meds_rule",
      "conditions": [
        {
          "field": "action",
          "op": "eq",
          "value": "dispense_meds"
        },
        {
          "field": "med_status",
          "op": "eq",
          "value": "prescribed"
        }
      ],
      "effects": [
        {
          "target": "state",
          "field": "med_status",
          "op": "set",
          "value": "dispensed"
        }
      ],
      "priority": 9,
      "probability": 1,
      "enabled": true,
      "cooldown": 0,
      "scope": "global"
    },
    {
      "id": "generate_invoice_rule",
      "conditions": [
        {
          "field": "action",
          "op": "eq",
          "value": "generate_invoice"
        },
        {
          "field": "med_status",
          "op": "eq",
          "value": "dispensed"
        },
        {
          "field": "invoice_status",
          "op": "in",
          "value": [
            "none",
            "paid"
          ]
        }
      ],
      "effects": [
        {
          "target": "state",
          "field": "invoice_status",
          "op": "set",
          "value": "generated"
        },
        {
          "target": "state",
          "field": "invoices_generated",
          "op": "increment",
          "value": 1
        }
      ],
      "priority": 8,
      "probability": 1,
      "enabled": true,
      "cooldown": 1,
      "scope": "global"
    },
    {
      "id": "collect_payment_rule",
      "conditions": [
        {
          "field": "action",
          "op": "eq",
          "value": "collect_payment"
        },
        {
          "field": "invoice_status",
          "op": "eq",
          "value": "generated"
        },
        {
          "field": "med_status",
          "op": "eq",
          "value": "dispensed"
        }
      ],
      "effects": [
        {
          "target": "state",
          "field": "invoice_status",
          "op": "set",
          "value": "paid"
        },
        {
          "target": "state",
          "field": "payments_collected",
          "op": "increment",
          "value": 1
        },
        {
          "target": "state",
          "field": "account_balance",
          "op": "add",
          "value": 1000
        },
        {
          "target": "state",
          "field": "med_status",
          "op": "set",
          "value": "consumed"
        },
        {
          "target": "state",
          "field": "payment_debt",
          "op": "set",
          "value": {
            "$sub": [
              {
                "$field": "payments_collected"
              },
              {
                "$field": "invoices_generated"
              }
            ]
          }
        }
      ],
      "priority": 10,
      "probability": 1,
      "enabled": true,
      "cooldown": 1,
      "scope": "global"
    },
    {
      "id": "audit_billing_rule",
      "conditions": [
        {
          "field": "action",
          "op": "eq",
          "value": "audit_billing"
        }
      ],
      "effects": [
        {
          "target": "state",
          "field": "invoices_generated",
          "op": "add",
          "value": 0
        }
      ],
      "priority": 3,
      "probability": 1,
      "enabled": true,
      "cooldown": 0,
      "scope": "global"
    },
    {
      "id": "heartbeat",
      "conditions": [
        {
          "field": "action",
          "op": "exists"
        }
      ],
      "effects": [
        {
          "target": "state",
          "field": "day",
          "op": "increment",
          "value": 1
        }
      ],
      "priority": 1,
      "probability": 1,
      "enabled": true,
      "cooldown": 0,
      "scope": "global"
    }
  ],
  "observations": {
    "fields": [
      {
        "field": "patient_status",
        "source": "patient_status",
        "visibility": "public"
      },
      {
        "field": "med_status",
        "source": "med_status",
        "visibility": "public"
      },
      {
        "field": "invoice_status",
        "source": "invoice_status",
        "visibility": "public"
      },
      {
        "field": "account_balance",
        "source": "account_balance",
        "visibility": "public"
      },
      {
        "field": "day",
        "source": "day",
        "visibility": "public"
      },
      {
        "field": "payment_debt",
        "source": "payment_debt",
        "visibility": "public"
      }
    ],
    "fullyObservable": false
  },
  "rewards": {
    "components": [
      {
        "id": "invoice_reward",
        "expression": "state.invoices_generated - prevState.invoices_generated",
        "weight": 3
      },
      {
        "id": "payment_reward",
        "expression": "state.payments_collected - prevState.payments_collected",
        "weight": 10
      },
      {
        "id": "balance_gain",
        "expression": "state.account_balance - prevState.account_balance",
        "weight": 0.001
      },
      {
        "id": "day_cost",
        "expression": "state.day - prevState.day",
        "weight": -0.05
      }
    ]
  },
  "constraints": [
    {
      "id": "payment_requires_dispense",
      "type": "range",
      "target": {
        "field": "payments_collected",
        "min": 0,
        "max": 50
      },
      "priority": 1,
      "satisfied": false
    },
    {
      "id": "invoice_requires_dispense",
      "type": "range",
      "target": {
        "field": "invoices_generated",
        "min": 0,
        "max": 50
      },
      "priority": 1,
      "satisfied": false
    },
    {
      "id": "payment_invoice_parity",
      "type": "range",
      "target": {
        "field": "payment_debt",
        "min": 0,
        "max": 0
      },
      "priority": 1,
      "satisfied": false
    }
  ],
  "termination": [
    {
      "field": "payments_collected",
      "op": "gte",
      "value": 3,
      "kind": "terminated"
    },
    {
      "field": "",
      "op": "eq",
      "value": 0,
      "kind": "truncated",
      "maxSteps": 120
    }
  ]
}