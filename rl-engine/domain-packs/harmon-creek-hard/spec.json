            "south",
            "east",
            "west"
          ]
        }
      }
    }
  ],
  "rules": [
    {
      "id": "admit_rule",
      "conditions": [
        {
          "field": "action",
          "op": "eq",
          "value": "admit_patient"
        },
        {
          "field": "ward_occupancy",
          "op": "lt",
          "value": 12
        },
        {
          "field": "battery",
          "op": "gte",
          "value": 1
        }
      ],
      "effects": [
        {
          "target": "state",
          "field": "ward_occupancy",
          "op": "increment",
          "value": 1
        },
        {
          "target": "state",
          "field": "battery",
          "op": "subtract",
          "value": 1
        }
      ],
      "priority": 10,
      "probability": 0.7,
      "enabled": true,
      "cooldown": 0,
      "scope": "global"
    },
    {
      "id": "discharge_rule",
      "conditions": [
        {
          "field": "action",
          "op": "eq",
          "value": "discharge_patient"
        },
        {
          "field": "ward_occupancy",
          "op": "gt",
          "value": 0
        }
      ],
      "effects": [
        {
          "target": "state",
          "field": "ward_occupancy",
          "op": "decrement",
          "value": 1
        }
      ],
      "priority": 5,
      "probability": 0.9,
      "enabled": true,
      "cooldown": 0,
      "scope": "global"
    },
    {
      "id": "restock_rule",
      "conditions": [
        {
          "field": "action",
          "op": "eq",
          "value": "restock"
        },
        {
          "field": "supplies",
          "op": "lt",
          "value": 100
        },
        {
          "field": "battery",
          "op": "gte",
          "value": 2
        }
      ],
      "effects": [
        {
          "target": "state",
          "field": "supplies",
          "op": "set",
          "value": 100
        },
        {
          "target": "state",
          "field": "battery",
          "op": "subtract",
          "value": 2
        }
      ],
      "priority": 7,
      "probability": 0.9,
      "enabled": true,
      "cooldown": 0,
      "scope": "global"
    },
    {
      "id": "transfer_rule",
      "conditions": [
        {
          "field": "action",
          "op": "eq",
          "value": "transfer_patient"
        },
        {
          "field": "day",
          "op": "lt",
          "value": 60
        }
      ],
      "effects": [
        {
          "target": "state",
          "field": "day",
          "op": "increment",
          "value": 1
        }
      ],
      "priority": 3,
      "probability": 1,
      "enabled": true,
      "cooldown": 0,
      "scope": "global"
    },
    {
      "id": "supplies_consumption",
      "conditions": [
        {
          "field": "supplies",
          "op": "gt",
          "value": 0
        }
      ],
      "effects": [
        {
          "target": "state",
          "field": "supplies",
          "op": "subtract",
          "value": 2
        }
      ],
      "priority": 2,
      "probability": 1,
      "enabled": true,
      "cooldown": 0,
      "scope": "global"
    },
    {
      "id": "incident_rule",
      "conditions": [
        {
          "field": "ward_occupancy",
          "op": "gte",
          "value": 8
        },
        {
          "field": "supplies",
          "op": "lt",
          "value": 50
        }
      ],
      "effects": [
        {
          "target": "state",
          "field": "incidents",
          "op": "increment",
          "value": 1
        },
        {
          "target": "state",
          "field": "battery",
          "op": "subtract",
          "value": 1
        }
      ],
      "priority": 6,
      "probability": 0.3,
      "enabled": true,
      "cooldown": 0,
      "scope": "global"
    },
    {
      "id": "budget_drain",
      "conditions": [
        {
          "field": "budget",
          "op": "gt",
          "value": 0
        }
      ],
      "effects": [
        {
          "target": "state",
          "field": "budget",
          "op": "subtract",
          "value": 1.5
        }
      ],
      "priority": 1,
      "probability": 1,
      "enabled": true,
      "cooldown": 0,
      "scope": "global"
    },
    {
      "id": "budget_reset",
