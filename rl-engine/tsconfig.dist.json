{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationMap": false,
    "outDir": "dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": false
  },
  "include": ["index.ts", "persistence/index.ts", "core/**/*.ts", "environment/**/*.ts", "observation/**/*.ts", "reward/**/*.ts", "episode/**/*.ts", "events/**/*.ts", "plugins/**/*.ts", "rl/**/*.ts"]
}
