{
  "environment": {
    "id": "harmon-creek-hospital",
    "version": "1.0.0",
    "specVersion": "1.0",
    "description": "Harmon Creek Regional Hospital — synthetic commissioning scenario on the generic RL environment engine. 10 entities (8 synthetic actors + 2 wards), 2 relationships, 4 action-conditioned rules, range constraints and reward composition. No real patient or employee data."
  },
  "state": {
    "ward_occupancy": {
      "type": "integer",
      "min": 0,
      "max": 12,
      "default": 0
    },
    "battery": {
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 100
    },
    "supplies": {
      "type": "float",
      "min": 0,
      "max": 100,
      "default": 50
    },
    "day": {
      "type": "integer",
      "min": 0,
      "max": 30,
      "default": 0
    }
  },
