{
  "name": "story-vault-mcp",
  "version": "2.2.0",
  "description": "MCP server for Story Vault — lets external AI clients (Claude Desktop, Cursor, Cline, Qwen Chat…) read and write your local encrypted writing vault.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "story-vault-mcp": "dist/index.cjs"
  },
  "files": [
    "dist/index.cjs",
    "dist/server.cjs",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "cd ../../ && npm run build:mcp:npm",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "better-sqlite3-multiple-ciphers": "^13.0.3"
  },
  "keywords": ["mcp", "model-context-protocol", "story-vault", "writing", "sqlcipher"],
  "publishConfig": {
    "access": "public"
  }
}
