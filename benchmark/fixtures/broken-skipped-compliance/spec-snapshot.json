      "attributes": {
        "role": "messenger"
      },
      "state": {
        "location": "TownSquare",
        "energy": "high"
      }
    },
    {
      "id": "sorin",
      "type": "actor",
      "attributes": {
        "role": "guard"
      },
      "state": {
        "location": "TownSquare",
        "energy": "high"
      }
    },
    {
      "id": "tessa",
      "type": "actor",
      "attributes": {
